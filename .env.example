
# --- Hangi yapay zeka saglayicisi ---
# claude = Anthropic Claude   |   groq = Groq (OpenAI uyumlu)
LLM_PROVIDER=claude

# --- Groq (LLM_PROVIDER=groq ise) ---
# https://console.groq.com/keys adresinden alin
GROQ_API_KEY=
# Arac cagirmayi destekleyen modeller: openai/gpt-oss-120b, openai/gpt-oss-20b,
# qwen/qwen3.6-27b   (guncel liste: https://console.groq.com/docs/models)
GROQ_MODEL=openai/gpt-oss-120b
# Gunluk token kotasi (TPD) Groq'ta HER MODEL ICIN AYRI tutulur. Ana modelin
# gunluk kotasi dolarsa sorular cevapsiz kalmasin diye otomatik olarak bu
# modele gecilir. Bos birakilirsa gecis yapilmaz.
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
# gpt-oss icin akil yurutme seviyesi (low|medium|high). Bos = gonderme.
# gpt-oss'ta "reasoning" ciktisi da token yakar; tek SELECT uretmek icin low yeterli.
GROQ_REASONING_EFFORT=low
# Groq ucretsiz katman dakikada 8000 token verir ve max_tokens KULLANILMASA BILE
# bu limite tam olarak sayilir. Bu yuzden dar tutulur; cevap yarida kesilirse
# kod otomatik olarak bir kez genis butceyle tekrar dener.
GROQ_MAX_TOKENS=700

# --- Hangi veritabani kullanilacak ---
# mssql = MS SQL Server (sirketin gercek veritabani)
# mysql = MySQL (Sakila ornek veritabani)
DB_TYPE=mssql

# --- MySQL baglantisi (DB_TYPE=mysql ise) ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=sakila
# --- Claude API ---
# https://console.anthropic.com/settings/keys adresinden alin
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-5
# low | medium | high | xhigh | max  (dusuk = daha hizli ve ucuz)
CLAUDE_EFFORT=medium

# --- MS SQL Server baglantisi ---
MSSQL_DRIVER=ODBC Driver 18 for SQL Server
MSSQL_SERVER=localhost\SQLEXPRESS
MSSQL_DATABASE=SirketDemo

# Windows kimlik dogrulamasi icin: yes  (kullanici/sifre bos birakilir)
MSSQL_TRUSTED_CONNECTION=yes
MSSQL_USER=
MSSQL_PASSWORD=

MSSQL_ENCRYPT=yes
MSSQL_TRUST_SERVER_CERTIFICATE=yes

# --- API erisim korumasi ---
# BOS BIRAKILIRSA /api/* uclari KORUMASIZDIR. Bu yalnizca yerel deneme icindir.
# Gercek sirket verisiyle calisirken mutlaka doldurun: sunucuya erisebilen
# herkes veritabanini sorgulayabilir ve LLM kotanizi tuketebilir.
# Ornek uretmek icin: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Istekler "Authorization: Bearer <anahtar>" ya da "X-API-Token: <anahtar>" bekler.
# Widget'a data-token="<anahtar>" olarak verilir.
# SINIR: Tarayiciya inen anahtar gizli degildir; sayfayi goren okuyabilir.
API_TOKEN=

# Ham SQL calistirma ucu (/api/sql). Dogal dil akisini atlar, arayuz kullanmaz.
# Varsayilan kapali; yalnizca guvendiginiz ortamda acin.
ALLOW_RAW_SQL=off

# --- Guvenlik / limitler ---
# Tek sorgudan donebilecek maksimum satir sayisi
MAX_ROWS=500
# Sonucun kac satiri yapay zekaya gonderilsin (ozet icin yeterli olan).
# Kullanici tabloyu tam gorur; bu yalnizca modele giden ornektir.
MODEL_ROW_SAMPLE=10

# Semanin yapay zekaya nasil yazilacagi: compact (az token) | detailed (okunakli)
SCHEMA_STYLE=compact
# Yapay zekaya hic gonderilmeyecek tablolar (virgulle ayrilir).
# Buyuk semalarda ilgisiz tablolari disarida birakmak ciddi token kazandirir.
SCHEMA_EXCLUDE_TABLES=
# --- Sema tazeligi ---
# Veritabani CANLIYSA kolon/tablo degisebilir. Bu sure dolunca sema yeniden
# taranir; boylece yapay zeka guncel kolonlari bilir ve SQL onbellegi de
# sema degisikligini fark edebilir (parmak izi semadan uretiliyor).
# Semasi hic degismeyen kurulumlarda 0 yazarak kapatabilirsiniz.
SCHEMA_TTL=3600

# --- Soru -> SQL onbellegi ---
# ONEMLI: Onbellek SONUC SAKLAMAZ, yalnizca "bu soru icin hangi SQL yazilmali"
# bilgisini saklar. Sorgu her seferinde yeniden calisir, dolayisiyla veri
# HER ZAMAN CANLIDIR. Verisi surekli degisen bir veritabaninda guvenlidir.
# Ayni soru tekrar soruldugunda "SQL uret" cagrisi atlanir (~1900 token kazanc).
# Kapatmak icin: off
SQL_CACHE=on
# Onbellek kaydinin omru (saniye). Sema degisirse kayitlar zaten kendiliginden
# duser; bu yalnizca is kurallari zamanla degisirse diye bir emniyet agidir.
SQL_CACHE_TTL=604800
# Sorgu zaman asimi (saniye)
QUERY_TIMEOUT=30
# Yapay zekanin ard arda calistirabilecegi maksimum sorgu sayisi
MAX_TOOL_TURNS=6

# --- Widget CORS ---
# Widget baska bir alan adindaki sayfaya gomulecekse buraya o adresleri yazin.
# Ornek: CORS_ORIGINS=https://portal.sirket.com,https://intranet.sirket.com
CORS_ORIGINS=*
